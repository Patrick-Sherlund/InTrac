# Default: only this computer can connect. Cloudflare Tunnel needs no changes.
INTRAC_BIND_ADDRESS=127.0.0.1
INTRAC_HTTP_PORT=80
INTRAC_HTTPS_PORT=443
INTRAC_SITE_ADDRESS=:80
INTRAC_TLS_DIRECTIVE=
# HTTPS automatically uses Secure cookies. Leave false for local HTTP login.
INTRAC_COOKIE_SECURE=false

# Only needed for a permanent Cloudflare Tunnel, never for a Quick Tunnel.
# Copy the eyJ... token here (not the full Docker command). Keep .env private.
CLOUDFLARE_TUNNEL_TOKEN=
